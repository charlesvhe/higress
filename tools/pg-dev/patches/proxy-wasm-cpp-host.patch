+Word pg_init(Word service_ptr, Word service_size, Word config_ptr, Word config_size,
+             Word client_ptr) {
+  auto *context = contextOrEffectiveContext()->root_context();
+  auto service = context->wasmVm()->getMemory(service_ptr, service_size);
+  auto config = context->wasmVm()->getMemory(config_ptr, config_size);
+  uint32_t client = 0;
+  if (!service || !config || !context->wasm()->setDatatype(client_ptr, client)) {
+    return WasmResult::InvalidMemoryAccess;
+  }
+  auto result = context->pgInit(service.value(), config.value(), &client);
+  context->wasm()->setDatatype(client_ptr, client);
+  return result;
+}
+
+Word pg_call(Word client_id, Word request_ptr, Word request_size, Word timeout_ms, Word token_ptr) {
+  // Unlike Redis, retain the origin context so deletion cancels its PG requests.
+  auto *context = contextOrEffectiveContext();
+  auto request = context->wasmVm()->getMemory(request_ptr, request_size);
+  uint32_t token = 0;
+  if (!request || !context->wasm()->setDatatype(token_ptr, token)) {
+    return WasmResult::InvalidMemoryAccess;
+  }
+  auto result = context->pgCall(client_id.u64_, request.value(), timeout_ms.u64_, &token);
+  context->wasm()->setDatatype(token_ptr, token);
+  return result;
+}

--- /dev/null
+++ b/source/common/postgres/codec.cc
@@ -0,0 +1,527 @@
+#include "source/common/postgres/codec.h"
+
+#include <algorithm>
+#include <array>
+#include <climits>
+#include <map>
+#include <memory>
+
+#include "openssl/crypto.h"
+#include "openssl/evp.h"
+#include "openssl/hmac.h"
+#include "openssl/md5.h"
+#include "openssl/rand.h"
+#include "openssl/sha.h"
+#include "unicode/usprep.h"
+#include "unicode/ustring.h"
+
+namespace Envoy {
+namespace Postgres {
+namespace {
+[[noreturn]] void protocol(const char* message) { throw Failure(Status::ProtocolError, message); }
+bool nul(std::string_view value) { return value.find('\0') != std::string_view::npos; }
+Json parseEnvelope(std::string_view data) {
+  // Bound DOM nesting as well as bytes, including ignored fields from raw host callers.
+  return Json::parse(data, [](int depth, Json::parse_event_t, Json&) {
+    if (depth > 16)
+      protocol("PostgreSQL envelope nesting exceeds supported limit");
+    return true;
+  });
+}
+uint32_t integer(const Json& j, const char* key, uint32_t lo, uint32_t hi) {
+  const auto& value = j.at(key);
+  if (!value.is_number_unsigned() && !value.is_number_integer())
+    protocol("invalid integer configuration");
+  auto number = value.get<int64_t>();
+  if (number < lo || number > hi)
+    protocol("configuration exceeds supported range");
+  return static_cast<uint32_t>(number);
+}
+std::string hex(std::string_view bytes) {
+  static constexpr char digits[] = "0123456789abcdef";
+  std::string result;
+  for (unsigned char c : bytes) {
+    result += digits[c >> 4];
+    result += digits[c & 15];
+  }
+  return result;
+}
+std::string base64(std::string_view bytes) {
+  std::string result(4 * ((bytes.size() + 2) / 3), '\0');
+  auto length = EVP_EncodeBlock(reinterpret_cast<uint8_t*>(result.data()),
+                                reinterpret_cast<const uint8_t*>(bytes.data()), bytes.size());
+  if (length < 0)
+    protocol("base64 encoding failed");
+  result.resize(length);
+  return result;
+}
+std::string unbase64(std::string_view value) {
+  if (value.empty() || value.size() > 4096 || value.size() % 4 != 0)
+    protocol("invalid SCRAM base64");
+  std::string result(value.size(), '\0');
+  int n = EVP_DecodeBlock(reinterpret_cast<uint8_t*>(result.data()),
+                          reinterpret_cast<const uint8_t*>(value.data()), value.size());
+  if (n < 0)
+    protocol("invalid SCRAM base64");
+  if (value.back() == '=')
+    --n;
+  if (value.size() > 1 && value[value.size() - 2] == '=')
+    --n;
+  if (n < 0)
+    protocol("invalid SCRAM base64");
+  result.resize(n);
+  if (base64(result) != value)
+    protocol("noncanonical SCRAM base64");
+  return result;
+}
+std::string sha256(std::string_view value) {
+  std::string result(SHA256_DIGEST_LENGTH, '\0');
+  SHA256(reinterpret_cast<const uint8_t*>(value.data()), value.size(),
+         reinterpret_cast<uint8_t*>(result.data()));
+  return result;
+}
+std::string hmac(std::string_view key, std::string_view value) {
+  std::string result(SHA256_DIGEST_LENGTH, '\0');
+  unsigned int length = 0;
+  if (!HMAC(EVP_sha256(), key.data(), key.size(), reinterpret_cast<const uint8_t*>(value.data()),
+            value.size(), reinterpret_cast<uint8_t*>(result.data()), &length) ||
+      length != result.size()) {
+    protocol("SCRAM HMAC failed");
+  }
+  return result;
+}
+// PostgreSQL uses the original password when SASLprep rejects its contents.
+std::string prepare(std::string_view password) {
+  UErrorCode error = U_ZERO_ERROR;
+  int32_t length = 0;
+  u_strFromUTF8(nullptr, 0, &length, password.data(), password.size(), &error);
+  if (error != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(error))
+    return std::string(password);
+  error = U_ZERO_ERROR;
+  std::vector<UChar> utf16(length + 1);
+  u_strFromUTF8(utf16.data(), utf16.size(), &length, password.data(), password.size(), &error);
+  if (U_FAILURE(error))
+    return std::string(password);
+  std::unique_ptr<UStringPrepProfile, decltype(&usprep_close)> profile(
+      usprep_openByType(USPREP_RFC4013_SASLPREP, &error), &usprep_close);
+  if (U_FAILURE(error))
+    protocol("SASLprep profile unavailable");
+  UParseError parse_error{};
+  std::vector<UChar> output(length * 4 + 32);
+  auto count = usprep_prepare(profile.get(), utf16.data(), length, output.data(), output.size(),
+                              USPREP_DEFAULT, &parse_error, &error);
+  if (error == U_BUFFER_OVERFLOW_ERROR) {
+    output.resize(count + 1);
+    error = U_ZERO_ERROR;
+    count = usprep_prepare(profile.get(), utf16.data(), length, output.data(), output.size(),
+                           USPREP_DEFAULT, &parse_error, &error);
+  }
+  if (U_FAILURE(error))
+    return std::string(password);
+  error = U_ZERO_ERROR;
+  int32_t bytes = 0;
+  u_strToUTF8(nullptr, 0, &bytes, output.data(), count, &error);
+  if (error != U_BUFFER_OVERFLOW_ERROR && U_FAILURE(error))
+    protocol("SASLprep conversion failed");
+  error = U_ZERO_ERROR;
+  std::string normalized(bytes, '\0');
+  u_strToUTF8(normalized.data(), normalized.size(), &bytes, output.data(), count, &error);
+  if (U_FAILURE(error))
+    protocol("SASLprep conversion failed");
+  return normalized;
+}
+std::map<char, std::string> attributes(std::string_view data) {
+  if (data.size() > 8192)
+    protocol("SCRAM message too large");
+  std::map<char, std::string> result;
+  while (!data.empty()) {
+    auto comma = data.find(',');
+    auto part = data.substr(0, comma);
+    if (part.size() < 3 || part[1] != '=' || !result.emplace(part[0], part.substr(2)).second)
+      protocol("invalid SCRAM attributes");
+    if (comma == std::string_view::npos)
+      break;
+    data.remove_prefix(comma + 1);
+    if (data.empty())
+      protocol("empty SCRAM attribute");
+  }
+  if (result.count('m'))
+    protocol("unsupported mandatory SCRAM extension");
+  return result;
+}
+} // namespace
+
+Config Config::parse(std::string_view data) {
+  if (data.size() > 16384)
+    protocol("PostgreSQL configuration too large");
+  try {
+    auto j = parseEnvelope(data);
+    if (integer(j, "version", 1, 1) != 1)
+      protocol("unsupported PG ABI version");
+    Config c;
+    c.username = j.at("username").get<std::string>();
+    c.password = j.at("password").get<std::string>();
+    c.database = j.at("database").get<std::string>();
+    c.tls_mode = j.at("tls_mode").get<std::string>();
+    if (c.username.empty() || c.database.empty() || nul(c.username) || nul(c.database) ||
+        nul(c.password) || (c.tls_mode != "disable" && c.tls_mode != "require"))
+      protocol("invalid PostgreSQL configuration");
+    c.connect_timeout_ms = integer(j, "connect_timeout_ms", 1, INT_MAX);
+    c.max_connections = integer(j, "max_connections", 1, 64);
+    c.max_pending_requests = integer(j, "max_pending_requests", 1, 1024);
+    c.max_rows = integer(j, "max_rows", 1, 100000);
+    c.max_response_bytes = integer(j, "max_response_bytes", 256, 16777216);
+    c.max_request_bytes = integer(j, "max_request_bytes", 64, 1048576);
+    c.idle_timeout_ms = integer(j, "idle_timeout_ms", 1, INT_MAX);
+    return c;
+  } catch (const Json::exception&) {
+    protocol("invalid PostgreSQL configuration envelope");
+  }
+}
+Query Query::parse(std::string_view data, uint32_t limit) {
+  if (data.size() > limit)
+    throw Failure(Status::ResourceExhausted, "query exceeds configured limit");
+  try {
+    const auto j = parseEnvelope(data);
+    integer(j, "version", 1, 1);
+    Query query;
+    query.sql = j.at("sql").get<std::string>();
+    const auto& params = j.at("params");
+    if (query.sql.empty() || nul(query.sql) || !params.is_array() || params.size() > INT16_MAX)
+      protocol("invalid SQL or parameters");
+    for (const auto& p : params) {
+      Param param{integer(p, "type_oid", 0, UINT32_MAX), std::nullopt};
+      if (!p.at("value").is_null()) {
+        param.value = p.at("value").get<std::string>();
+        if (nul(*param.value))
+          protocol("NUL in PostgreSQL parameter");
+      }
+      query.params.push_back(std::move(param));
+    }
+    return query;
+  } catch (const Json::exception&) {
+    protocol("invalid PostgreSQL query envelope");
+  }
+}
+void Decoder::append(std::string_view data) {
+  if (data.size() > limit_ || buffered() > limit_ - data.size())
+    throw Failure(Status::ResourceExhausted, "PostgreSQL input exceeds configured limit");
+  if (offset_) {
+    input_.erase(0, offset_);
+    offset_ = 0;
+  }
+  input_.append(data);
+}
+void Decoder::setLimit(uint32_t limit) {
+  if (buffered() > limit) {
+    throw Failure(Status::ResourceExhausted, "PostgreSQL input exceeds configured limit");
+  }
+  // Release a large previous query buffer before returning an idle connection.
+  std::string remaining = input_.substr(offset_);
+  input_.swap(remaining);
+  offset_ = 0;
+  limit_ = limit;
+}
+
+bool Decoder::next(char& type, std::string& body) {
+  if (buffered() < 5)
+    return false;
+  Reader header(std::string_view(input_).substr(offset_ + 1, 4));
+  uint32_t size = header.u32();
+  if (size < 4)
+    protocol("invalid PostgreSQL message length");
+  if (size > limit_ - 1)
+    throw Failure(Status::ResourceExhausted, "PostgreSQL message exceeds configured limit");
+  if (buffered() < size + 1)
+    return false;
+  type = input_[offset_];
+  body.assign(input_, offset_ + 5, size - 4);
+  offset_ += size + 1;
+  return true;
+}
+uint16_t Reader::u16() {
+  auto b = bytes(2);
+  return (static_cast<uint8_t>(b[0]) << 8) | static_cast<uint8_t>(b[1]);
+}
+uint32_t Reader::u32() {
+  auto b = bytes(4);
+  uint32_t value = 0;
+  for (unsigned char c : b)
+    value = (value << 8) | c;
+  return value;
+}
+std::string_view Reader::bytes(size_t size) {
+  if (size > data_.size())
+    protocol("truncated PostgreSQL message");
+  auto part = data_.substr(0, size);
+  data_.remove_prefix(size);
+  return part;
+}
+std::string Reader::string() {
+  auto size = data_.find('\0');
+  if (size == std::string_view::npos)
+    protocol("unterminated PostgreSQL string");
+  std::string part(data_.substr(0, size));
+  data_.remove_prefix(size + 1);
+  return part;
+}
+void Reader::end() const {
+  if (!data_.empty())
+    protocol("trailing PostgreSQL message data");
+}
+void put16(std::string& data, uint16_t n) {
+  data += static_cast<char>(n >> 8);
+  data += static_cast<char>(n);
+}
+void put32(std::string& data, uint32_t n) {
+  for (int shift = 24; shift >= 0; shift -= 8)
+    data += static_cast<char>(n >> shift);
+}
+std::string message(char type, std::string_view body) {
+  if (body.size() > INT_MAX - 4)
+    protocol("PostgreSQL output too large");
+  std::string data(1, type);
+  put32(data, body.size() + 4);
+  data.append(body);
+  return data;
+}
+std::string startup(const Config& c) {
+  std::string data;
+  put32(data, 196608);
+  for (const auto& pair :
+       std::vector<std::pair<std::string, std::string>>{{"user", c.username},
+                                                        {"database", c.database},
+                                                        {"client_encoding", "UTF8"},
+                                                        {"application_name", "higress-wasm"}}) {
+    data += pair.first;
+    data += '\0';
+    data += pair.second;
+    data += '\0';
+  }
+  data += '\0';
+  std::string length;
+  put32(length, data.size() + 4);
+  return length + data;
+}
+std::string sslRequest() {
+  std::string data;
+  put32(data, 8);
+  put32(data, 80877103);
+  return data;
+}
+std::string queryMessages(const Query& q) {
+  std::string parse(1, '\0');
+  parse += q.sql;
+  parse += '\0';
+  put16(parse, q.params.size());
+  for (const auto& p : q.params)
+    put32(parse, p.oid);
+  std::string bind(2, '\0');
+  put16(bind, 0);
+  put16(bind, q.params.size());
+  for (const auto& p : q.params) {
+    put32(bind, p.value ? p.value->size() : UINT32_MAX);
+    if (p.value)
+      bind += *p.value;
+  }
+  put16(bind, 0);
+  std::string describe("P", 1);
+  describe += '\0';
+  std::string execute(1, '\0');
+  put32(execute, 0);
+  return message('P', parse) + message('B', bind) + message('D', describe) + message('E', execute) +
+         message('S', "");
+}
+std::string discardAll() { return message('Q', std::string("DISCARD ALL\0", 12)); }
+std::string passwordMessage(std::string_view p) {
+  std::string data(p);
+  data += '\0';
+  return message('p', data);
+}
+std::string md5Password(const Config& c, std::string_view salt) {
+  if (salt.size() != 4)
+    protocol("invalid MD5 salt");
+  auto digest = [](std::string_view s) {
+    std::string d(MD5_DIGEST_LENGTH, '\0');
+    MD5(reinterpret_cast<const uint8_t*>(s.data()), s.size(), reinterpret_cast<uint8_t*>(d.data()));
+    return hex(d);
+  };
+  return "md5" + digest(digest(c.password + c.username) + std::string(salt));
+}
+std::string errorEnvelope(const Failure& failure) {
+  Json j{{"version", 1}, {"message", failure.what()}, {"sqlstate", nullptr}};
+  if (!failure.sqlstate.empty())
+    j["sqlstate"] = failure.sqlstate;
+  return j.dump(-1, ' ', false, Json::error_handler_t::replace);
+}
+Failure databaseError(std::string_view body, bool auth) {
+  Reader reader(body);
+  std::string code;
+  bool ended = false;
+  while (reader.remaining()) {
+    char key = reader.bytes(1)[0];
+    if (!key) {
+      ended = true;
+      break;
+    }
+    auto value = reader.string();
+    if (key == 'C')
+      code = value;
+  }
+  reader.end();
+  if (!ended)
+    protocol("invalid PostgreSQL ErrorResponse");
+  if (code.size() != 5 || !std::all_of(code.begin(), code.end(), [](unsigned char c) {
+        return (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z');
+      })) {
+    protocol("invalid PostgreSQL SQLSTATE");
+  }
+  // SQL diagnostics may echo SQL/parameters/credentials: expose a stable message and SQLSTATE.
+  return Failure(auth ? Status::AuthenticationError : Status::DatabaseError,
+                 auth ? "PostgreSQL authentication failed" : "PostgreSQL query failed", code);
+}
+std::string Scram::start(std::string_view mechanisms) {
+  if (started_)
+    protocol("repeated SASL authentication");
+  Reader r(mechanisms);
+  bool supported = false, ended = false;
+  while (r.remaining()) {
+    auto method = r.string();
+    if (method.empty()) {
+      ended = true;
+      break;
+    }
+    if (method == "SCRAM-SHA-256")
+      supported = true;
+  }
+  r.end();
+  if (!ended || !supported)
+    throw Failure(Status::AuthenticationError, "unsupported PostgreSQL SASL mechanism");
+  std::array<uint8_t, 24> random{};
+  if (RAND_bytes(random.data(), random.size()) != 1)
+    protocol("SCRAM random generation failed");
+  nonce_ = base64({reinterpret_cast<const char*>(random.data()), random.size()});
+  first_bare_ = "n=,r=" + nonce_;
+  started_ = true;
+  auto first = "n,," + first_bare_;
+  std::string data("SCRAM-SHA-256\0", 14);
+  put32(data, first.size());
+  data += first;
+  return message('p', data);
+}
+std::string Scram::continueWith(std::string_view server, std::string_view password) {
+  if (!started_ || continued_)
+    protocol("unexpected SCRAM continue");
+  auto a = attributes(server);
+  if (!a.count('r') || !a.count('s') || !a.count('i') || a['r'].size() <= nonce_.size() ||
+      a['r'].compare(0, nonce_.size(), nonce_) != 0)
+    protocol("invalid SCRAM server nonce");
+  uint32_t iterations = 0;
+  for (unsigned char c : a['i']) {
+    if (c < '0' || c > '9' || iterations > 100000 / 10)
+      protocol("invalid SCRAM iteration count");
+    iterations = iterations * 10 + c - '0';
+  }
+  if (iterations == 0 || iterations > 100000)
+    protocol("SCRAM iteration count out of range");
+  auto salt = unbase64(a['s']);
+  auto normalized = prepare(password);
+  std::string salted(32, '\0');
+  if (PKCS5_PBKDF2_HMAC(normalized.data(), normalized.size(),
+                        reinterpret_cast<const uint8_t*>(salt.data()), salt.size(), iterations,
+                        EVP_sha256(), salted.size(),
+                        reinterpret_cast<uint8_t*>(salted.data())) != 1)
+    protocol("SCRAM key derivation failed");
+  auto final = "c=biws,r=" + a['r'];
+  auto auth = first_bare_ + "," + std::string(server) + "," + final;
+  auto client_key = hmac(salted, "Client Key");
+  auto signature = hmac(sha256(client_key), auth);
+  auto server_key = hmac(salted, "Server Key");
+  expected_server_ = hmac(server_key, auth);
+  for (size_t i = 0; i < client_key.size(); ++i)
+    client_key[i] ^= signature[i];
+  continued_ = true;
+  return message('p', final + ",p=" + base64(client_key));
+}
+void Scram::finish(std::string_view server) {
+  if (!continued_ || verified_)
+    protocol("unexpected SCRAM final");
+  auto a = attributes(server);
+  if (a.count('e'))
+    throw Failure(Status::AuthenticationError, "SCRAM authentication rejected");
+  if (!a.count('v'))
+    protocol("missing SCRAM server signature");
+  auto actual = unbase64(a['v']);
+  if (actual.size() != expected_server_.size() ||
+      CRYPTO_memcmp(actual.data(), expected_server_.data(), actual.size()) != 0)
+    throw Failure(Status::AuthenticationError, "invalid SCRAM server signature");
+  verified_ = true;
+}
+void Result::columns(std::string_view body) {
+  if (has_columns_ || completed_)
+    protocol("unexpected RowDescription");
+  Reader reader(body);
+  auto count = reader.u16();
+  for (unsigned i = 0; i < count; ++i) {
+    auto name = reader.string();
+    reader.u32();
+    reader.u16();
+    auto oid = reader.u32();
+    reader.u16();
+    reader.u32();
+    auto format = reader.u16();
+    if (format != 0)
+      protocol("binary results are not supported");
+    Json column{{"name", name}, {"type_oid", oid}};
+    encoded_size_ += column.dump().size() + 1;
+    if (encoded_size_ > limit_)
+      throw Failure(Status::ResourceExhausted, "PostgreSQL result exceeds configured limit");
+    columns_.push_back(std::move(column));
+  }
+  reader.end();
+  has_columns_ = true;
+}
+void Result::row(std::string_view body) {
+  if (!has_columns_ || completed_)
+    protocol("unexpected DataRow");
+  if (rows_.size() >= max_rows_)
+    throw Failure(Status::ResourceExhausted, "PostgreSQL row limit exceeded");
+  Reader reader(body);
+  auto count = reader.u16();
+  if (count != columns_.size())
+    protocol("PostgreSQL column count mismatch");
+  Json row = Json::array();
+  for (unsigned i = 0; i < count; ++i) {
+    auto size = reader.u32();
+    if (size == UINT32_MAX)
+      row.push_back(nullptr);
+    else
+      row.push_back(std::string(reader.bytes(size)));
+  }
+  reader.end();
+  encoded_size_ += row.dump().size() + 1;
+  if (encoded_size_ > limit_)
+    throw Failure(Status::ResourceExhausted, "PostgreSQL result exceeds configured limit");
+  rows_.push_back(std::move(row));
+}
+void Result::command(std::string_view body) {
+  if (completed_)
+    protocol("multiple CommandComplete messages");
+  Reader reader(body);
+  command_ = reader.string();
+  reader.end();
+  completed_ = true;
+}
+std::string Result::encode() const {
+  if (!completed_)
+    protocol("missing CommandComplete");
+  auto data =
+      Json{{"version", 1}, {"columns", columns_}, {"rows", rows_}, {"command_tag", command_}}
+          .dump();
+  if (data.size() > limit_)
+    throw Failure(Status::ResourceExhausted, "PostgreSQL result exceeds configured limit");
+  return data;
+}
+
+} // namespace Postgres
+} // namespace Envoy
diff --git a/source/common/postgres/codec.h b/source/common/postgres/codec.h
new file mode 100644
index 0000000..f870a5b
--- /dev/null
+++ b/source/common/postgres/codec.h
@@ -0,0 +1,120 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "include/nlohmann/json.hpp"
+
+namespace Envoy {
+namespace Postgres {
+
+using Json = nlohmann::json;
+enum class Status : uint32_t {
+  Ok = 0,
+  DatabaseError = 1,
+  NetworkError = 2,
+  Timeout = 3,
+  AuthenticationError = 4,
+  ProtocolError = 5,
+  ResourceExhausted = 6
+};
+struct Failure : public std::runtime_error {
+  Failure(Status status, const std::string& message, std::string sqlstate = {})
+      : std::runtime_error(message), status(status), sqlstate(std::move(sqlstate)) {}
+  Status status;
+  std::string sqlstate;
+};
+struct Config {
+  std::string username, password, database, tls_mode;
+  uint32_t connect_timeout_ms, max_connections, max_pending_requests;
+  uint32_t max_rows, max_response_bytes, max_request_bytes, idle_timeout_ms;
+  static Config parse(std::string_view data);
+};
+struct Param {
+  uint32_t oid;
+  std::optional<std::string> value;
+};
+struct Query {
+  std::string sql;
+  std::vector<Param> params;
+  static Query parse(std::string_view data, uint32_t limit);
+};
+
+// Bounded incremental decoder; each emitted message excludes its type/length header.
+class Decoder {
+public:
+  explicit Decoder(uint32_t limit) : limit_(limit) {}
+  void append(std::string_view data);
+  void setLimit(uint32_t limit);
+  bool next(char& type, std::string& body);
+  size_t buffered() const { return input_.size() - offset_; }
+
+private:
+  std::string input_;
+  size_t offset_{0};
+  uint32_t limit_;
+};
+
+class Reader {
+public:
+  explicit Reader(std::string_view data) : data_(data) {}
+  uint16_t u16();
+  uint32_t u32();
+  std::string_view bytes(size_t size);
+  std::string string();
+  void end() const;
+  size_t remaining() const { return data_.size(); }
+
+private:
+  std::string_view data_;
+};
+void put16(std::string& data, uint16_t value);
+void put32(std::string& data, uint32_t value);
+std::string message(char type, std::string_view body);
+std::string startup(const Config& config);
+std::string sslRequest();
+std::string queryMessages(const Query& query);
+std::string discardAll();
+std::string passwordMessage(std::string_view password);
+std::string md5Password(const Config& config, std::string_view salt);
+std::string errorEnvelope(const Failure& failure);
+Failure databaseError(std::string_view body, bool authenticating);
+
+// SCRAM-SHA-256 with SASLprep, bounded PBKDF2 and constant-time server verification.
+class Scram {
+public:
+  std::string start(std::string_view mechanisms);
+  std::string continueWith(std::string_view server_first, std::string_view password);
+  void finish(std::string_view server_final);
+  bool verified() const { return verified_; }
+
+private:
+  std::string nonce_, first_bare_, expected_server_;
+  bool started_{false}, continued_{false}, verified_{false};
+};
+
+class Result {
+public:
+  explicit Result(const Config& config)
+      : max_rows_(config.max_rows), limit_(config.max_response_bytes) {}
+  void columns(std::string_view body);
+  void row(std::string_view body);
+  void command(std::string_view body);
+  std::string encode() const;
+  bool hasColumns() const { return has_columns_; }
+  bool completed() const { return completed_; }
+
+private:
+  Json columns_ = Json::array(), rows_ = Json::array();
+  std::string command_;
+  uint32_t max_rows_, limit_;
+  size_t encoded_size_{128};
+  bool has_columns_{false}, completed_{false};
+};
+
+} // namespace Postgres
+} // namespace Envoy

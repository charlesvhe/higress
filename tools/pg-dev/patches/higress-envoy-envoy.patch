index 0000000..13e0c07
--- /dev/null
+++ b/source/common/postgres/async_client.cc
@@ -0,0 +1,609 @@
+#include "source/common/postgres/async_client.h"
+
+#include <algorithm>
+#include <deque>
+#include <unordered_set>
+
+#include "envoy/network/connection.h"
+#include "envoy/network/filter.h"
+#include "envoy/ssl/connection.h"
+#include "envoy/stats/scope.h"
+#include "envoy/stats/stats.h"
+#include "envoy/upstream/thread_local_cluster.h"
+#include "source/common/buffer/buffer_impl.h"
+
+namespace Envoy {
+namespace Postgres {
+namespace {
+// Hard worker-wide backstops in addition to per-client budgets.
+struct Budget {
+  size_t clients{0}, connections{0}, requests{0}, reserved_bytes{0};
+};
+thread_local Budget budget;
+constexpr size_t MaxClients = 128, MaxConnections = 256, MaxRequests = 2048;
+constexpr size_t MaxReservedBytes = 512 * 1024 * 1024;
+class Client;
+class Session;
+class Pending : public Request, public std::enable_shared_from_this<Pending> {
+public:
+  Pending(std::weak_ptr<Client> owner, Query query, AsyncClient::Callback callback,
+          Event::Dispatcher& dispatcher, size_t reservation)
+      : owner_(owner), query_(std::move(query)), callback_(std::move(callback)),
+        dispatcher_(dispatcher), reservation_(reservation),
+        started_(dispatcher.timeSource().monotonicTime()) {}
+  ~Pending() override;
+  void cancel() override;
+  void finish(Status status, std::string body);
+  std::weak_ptr<Client> owner_;
+  Query query_;
+  AsyncClient::Callback callback_;
+  Event::Dispatcher& dispatcher_;
+  Event::TimerPtr timer_;
+  std::weak_ptr<Session> session_;
+  bool done_{false}, cancelled_{false}, queued_{true};
+  size_t reservation_;
+  MonotonicTime started_;
+};
+class Session : public Network::ReadFilter,
+                public Network::ConnectionCallbacks,
+                public std::enable_shared_from_this<Session> {
+public:
+  enum class State { Connecting, SslReply, Authenticating, Ready, Querying, Resetting, Closed };
+  Session(std::weak_ptr<Client> client, const Config& config, Event::Dispatcher& dispatcher,
+          Stats::ScopeSharedPtr stats)
+      : client_(client), config_(config), dispatcher_(dispatcher), decoder_(16384), result_(config),
+        stats_(std::move(stats)) {}
+  ~Session() override;
+  void connect(Upstream::ThreadLocalCluster& cluster);
+  void assign(const std::shared_ptr<Pending>& request);
+  void close();
+  void fail(const Failure& error);
+  bool usable(Upstream::ThreadLocalCluster& cluster) const;
+  void onEvent(Network::ConnectionEvent event) override;
+  void onAboveWriteBufferHighWatermark() override {}
+  void onBelowWriteBufferLowWatermark() override {}
+  void initializeReadFilterCallbacks(Network::ReadFilterCallbacks&) override {}
+  Network::FilterStatus onNewConnection() override { return Network::FilterStatus::Continue; }
+  Network::FilterStatus onData(Buffer::Instance& data, bool end_stream) override;
+  void process(char type, const std::string& body);
+  void send(const std::string& data);
+  void execute();
+  void idle();
+  std::weak_ptr<Client> client_;
+  const Config config_;
+  Event::Dispatcher& dispatcher_;
+  Network::ClientConnectionPtr connection_;
+  Upstream::HostDescriptionConstSharedPtr host_;
+  Upstream::ClusterInfoConstSharedPtr cluster_info_;
+  Upstream::ResourceAutoIncDecPtr connection_resource_;
+  Event::TimerPtr connect_timer_, idle_timer_;
+  State state_{State::Connecting};
+  Decoder decoder_;
+  Result result_;
+  Scram scram_;
+  bool authenticated_{false}, scram_used_{false}, reset_complete_{false}, counted_{false};
+  std::optional<Failure> query_error_;
+  std::string response_;
+  std::shared_ptr<Pending> request_;
+  Stats::ScopeSharedPtr stats_;
+};
+class Client : public AsyncClient, public std::enable_shared_from_this<Client> {
+public:
+  Client(std::string cluster, Config config, Upstream::ClusterManager& manager,
+         Event::Dispatcher& dispatcher)
+      : cluster_(std::move(cluster)), config_(std::move(config)), manager_(manager),
+        dispatcher_(dispatcher) {
+    auto* native = manager_.getThreadLocalCluster(cluster_);
+    if (!native)
+      throw Failure(Status::NetworkError, "PostgreSQL cluster unavailable");
+    stats_ = native->info()->statsScope().createScope("wasm_pg.");
+    ++budget.clients;
+  }
+  ~Client() override {
+    shutdown();
+    --budget.clients;
+  }
+  RequestPtr send(std::string_view data, std::chrono::milliseconds timeout,
+                  Callback callback) override;
+  void shutdown() override;
+  void pump();
+  void completed(Pending& request, Status status);
+  void schedule() {
+    if (scheduled_ || stopped_)
+      return;
+    scheduled_ = true;
+    dispatcher_.post([weak = weak_from_this()] {
+      if (auto self = weak.lock()) {
+        self->scheduled_ = false;
+        self->pump();
+      }
+    });
+  }
+  std::string cluster_;
+  Config config_;
+  Upstream::ClusterManager& manager_;
+  Event::Dispatcher& dispatcher_;
+  std::deque<std::shared_ptr<Pending>> pending_;
+  std::vector<std::shared_ptr<Session>> sessions_;
+  Stats::ScopeSharedPtr stats_;
+  size_t active_{0};
+  Event::TimerPtr retry_timer_;
+  bool stopped_{false}, scheduled_{false};
+};
+
+Pending::~Pending() {
+  if (reservation_)
+    budget.reserved_bytes -= reservation_;
+}
+void Pending::cancel() {
+  cancelled_ = true;
+  callback_ = nullptr;
+  if (done_)
+    return;
+  if (auto session = session_.lock())
+    session->close();
+  finish(Status::NetworkError, "");
+}
+void Pending::finish(Status status, std::string body) {
+  if (done_)
+    return;
+  done_ = true;
+  if (timer_)
+    timer_->disableTimer();
+  if (auto owner = owner_.lock())
+    owner->completed(*this, status);
+  if (cancelled_)
+    return;
+  auto self = shared_from_this();
+  dispatcher_.post([self, status, body = std::move(body)]() mutable {
+    if (auto owner = self->owner_.lock();
+        owner && !owner->stopped_ && !self->cancelled_ && self->callback_) {
+      auto callback = std::move(self->callback_);
+      callback(status, std::move(body));
+    }
+  });
+}
+RequestPtr Client::send(std::string_view data, std::chrono::milliseconds timeout,
+                        Callback callback) {
+  auto query = Query::parse(data, config_.max_request_bytes);
+  // Reserve for JSON + protocol + escaped values + transient callback copies.
+  size_t reservation =
+      16ULL * config_.max_response_bytes + 4ULL * config_.max_request_bytes + 65536;
+  if (stopped_ || budget.requests >= MaxRequests ||
+      budget.reserved_bytes + reservation > MaxReservedBytes ||
+      pending_.size() >= config_.max_pending_requests) {
+    stats_->counterFromString("rejected").inc();
+    return nullptr;
+  }
+  auto request = std::make_shared<Pending>(weak_from_this(), std::move(query), std::move(callback),
+                                           dispatcher_, reservation);
+  budget.reserved_bytes += reservation;
+  ++budget.requests;
+  ++active_;
+  stats_->counterFromString("requests").inc();
+  stats_->gaugeFromString("active", Stats::Gauge::ImportMode::Accumulate).inc();
+  stats_->gaugeFromString("pending", Stats::Gauge::ImportMode::Accumulate).inc();
+  request->timer_ = dispatcher_.createTimer([weak = std::weak_ptr<Pending>(request)] {
+    if (auto request = weak.lock()) {
+      if (request->done_)
+        return;
+      if (auto session = request->session_.lock())
+        session->close();
+      request->finish(Status::Timeout, errorEnvelope(Failure(
+                                           Status::Timeout, "PostgreSQL query deadline exceeded")));
+    }
+  });
+  request->timer_->enableTimer(timeout);
+  pending_.push_back(request);
+  schedule();
+  return request;
+}
+void Client::completed(Pending& request, Status status) {
+  --active_;
+  --budget.requests;
+  stats_->gaugeFromString("active", Stats::Gauge::ImportMode::Accumulate).dec();
+  if (request.queued_)
+    stats_->gaugeFromString("pending", Stats::Gauge::ImportMode::Accumulate).dec();
+  static const char* names[] = {"success",           "database_error",       "network_error",
+                                "timeout",           "authentication_error", "protocol_error",
+                                "resource_exhausted"};
+  stats_->counterFromString(request.cancelled_ ? "cancelled" : names[static_cast<uint32_t>(status)])
+      .inc();
+  auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+                     dispatcher_.timeSource().monotonicTime() - request.started_)
+                     .count();
+  stats_->histogramFromString("duration_ms", Stats::Histogram::Unit::Milliseconds)
+      .recordValue(elapsed);
+  pending_.erase(std::remove_if(pending_.begin(), pending_.end(),
+                                [&request](const auto& p) { return p.get() == &request; }),
+                 pending_.end());
+  schedule();
+}
+void Client::shutdown() {
+  if (stopped_)
+    return;
+  stopped_ = true;
+  if (retry_timer_)
+    retry_timer_->disableTimer();
+  auto pending = std::move(pending_);
+  for (auto& request : pending)
+    request->cancel();
+  for (auto& session : sessions_) {
+    if (session->request_)
+      session->request_->cancel();
+    session->close();
+  }
+  sessions_.clear();
+}
+void Client::pump() {
+  if (stopped_)
+    return;
+  auto* cluster = manager_.getThreadLocalCluster(cluster_);
+  for (auto& session : sessions_) {
+    if (session->state_ != Session::State::Closed && (!cluster || !session->usable(*cluster))) {
+      session->fail(Failure(Status::NetworkError, "PostgreSQL cluster or endpoint changed"));
+    }
+  }
+  sessions_.erase(std::remove_if(sessions_.begin(), sessions_.end(),
+                                 [](const auto& s) { return s->state_ == Session::State::Closed; }),
+                  sessions_.end());
+  while (!pending_.empty()) {
+    auto request = pending_.front();
+    if (request->done_) {
+      pending_.pop_front();
+      continue;
+    }
+    if (!cluster) {
+      request->finish(
+          Status::NetworkError,
+          errorEnvelope(Failure(Status::NetworkError, "PostgreSQL cluster unavailable")));
+      continue;
+    }
+    auto ready = std::find_if(sessions_.begin(), sessions_.end(),
+                              [](const auto& s) { return s->state_ == Session::State::Ready; });
+    if (ready != sessions_.end()) {
+      pending_.pop_front();
+      request->queued_ = false;
+      stats_->gaugeFromString("pending", Stats::Gauge::ImportMode::Accumulate).dec();
+      (*ready)->assign(request);
+      continue;
+    }
+    if (sessions_.size() >= config_.max_connections || budget.connections >= MaxConnections) {
+      if (!retry_timer_)
+        retry_timer_ = dispatcher_.createTimer([weak = weak_from_this()] {
+          if (auto self = weak.lock())
+            self->schedule();
+        });
+      retry_timer_->enableTimer(std::chrono::milliseconds(5));
+      break;
+    }
+    pending_.pop_front();
+    request->queued_ = false;
+    stats_->gaugeFromString("pending", Stats::Gauge::ImportMode::Accumulate).dec();
+    auto session = std::make_shared<Session>(weak_from_this(), config_, dispatcher_, stats_);
+    sessions_.push_back(session);
+    session->request_ = request;
+    request->session_ = session;
+    try {
+      session->connect(*cluster);
+    } catch (const Failure& error) {
+      session->fail(error);
+    }
+  }
+}
+Session::~Session() { close(); }
+bool Session::usable(Upstream::ThreadLocalCluster& cluster) const {
+  if (cluster.info() != cluster_info_ || !host_)
+    return false;
+  for (const auto& set : cluster.prioritySet().hostSetsPerPriority()) {
+    for (const auto& host : set->hosts())
+      if (host.get() == host_.get())
+        return true;
+  }
+  return false;
+}
+void Session::connect(Upstream::ThreadLocalCluster& cluster) {
+  cluster_info_ = cluster.info();
+  auto& resources =
+      cluster_info_->resourceManager(Upstream::ResourcePriority::Default).connections();
+  if (!resources.canCreate())
+    throw Failure(Status::ResourceExhausted, "PostgreSQL cluster connection limit exceeded");
+  auto result = cluster.tcpConn(nullptr);
+  connection_ = std::move(result.connection_);
+  host_ = std::move(result.host_description_);
+  if (!connection_)
+    throw Failure(Status::NetworkError, "PostgreSQL has no available endpoint");
+  connection_resource_ = std::make_unique<Upstream::ResourceAutoIncDec>(resources);
+  ++budget.connections;
+  counted_ = true;
+  stats_->gaugeFromString("connections", Stats::Gauge::ImportMode::Accumulate).inc();
+  connection_->setBufferLimits(std::max<uint32_t>(config_.max_response_bytes, 16384));
+  connection_->noDelay(true);
+  connection_->addReadFilter(shared_from_this());
+  connection_->addConnectionCallbacks(*this);
+  connect_timer_ = dispatcher_.createTimer([weak = weak_from_this()] {
+    if (auto self = weak.lock())
+      self->fail(Failure(Status::Timeout, "PostgreSQL connection deadline exceeded"));
+  });
+  connect_timer_->enableTimer(std::chrono::milliseconds(config_.connect_timeout_ms));
+  connection_->connect();
+}
+void Session::close() {
+  state_ = State::Closed;
+  if (connect_timer_)
+    connect_timer_->disableTimer();
+  if (idle_timer_)
+    idle_timer_->disableTimer();
+  if (connection_) {
+    connection_->removeConnectionCallbacks(*this);
+    connection_->close(Network::ConnectionCloseType::NoFlush);
+    dispatcher_.deferredDelete(std::move(connection_));
+  }
+  connection_resource_.reset();
+  if (counted_) {
+    --budget.connections;
+    stats_->gaugeFromString("connections", Stats::Gauge::ImportMode::Accumulate).dec();
+    counted_ = false;
+  }
+  if (auto client = client_.lock())
+    client->schedule();
+}
+void Session::fail(const Failure& error) {
+  auto keep_alive = shared_from_this();
+  close();
+  auto request = std::move(request_);
+  if (request)
+    request->finish(error.status, errorEnvelope(error));
+}
+void Session::send(const std::string& data) {
+  if (!connection_)
+    throw Failure(Status::NetworkError, "PostgreSQL connection closed");
+  Buffer::OwnedImpl buffer(data);
+  connection_->write(buffer, false);
+}
+void Session::onEvent(Network::ConnectionEvent event) {
+  auto keep_alive = shared_from_this();
+  if (state_ == State::Closed)
+    return;
+  try {
+    if (event == Network::ConnectionEvent::Connected) {
+      if (state_ != State::Connecting)
+        return;
+      if (config_.tls_mode == "require") {
+        state_ = State::SslReply;
+        send(sslRequest());
+      } else {
+        state_ = State::Authenticating;
+        send(startup(config_));
+      }
+    } else if (event == Network::ConnectionEvent::RemoteClose ||
+               event == Network::ConnectionEvent::LocalClose) {
+      fail(Failure(Status::NetworkError, "PostgreSQL connection closed"));
+    }
+  } catch (const Failure& error) {
+    fail(error);
+  }
+}
+Network::FilterStatus Session::onData(Buffer::Instance& data, bool end_stream) {
+  auto keep_alive = shared_from_this();
+  try {
+    if (state_ == State::Closed) {
+      data.drain(data.length());
+      return Network::FilterStatus::StopIteration;
+    }
+    if (state_ == State::SslReply && data.length()) {
+      char reply;
+      data.copyOut(0, 1, &reply);
+      data.drain(1);
+      if (reply != 'S' || data.length() != 0 || !connection_->startSecureTransport())
+        throw Failure(Status::AuthenticationError,
+                      "PostgreSQL TLS negotiation failed; configure a StartTLS cluster");
+      state_ = State::Authenticating;
+      send(startup(config_));
+    }
+    while (data.length()) {
+      size_t size = std::min<uint64_t>(data.length(), 4096);
+      std::string chunk(size, '\0');
+      data.copyOut(0, size, chunk.data());
+      data.drain(size);
+      decoder_.append(chunk);
+      char type;
+      std::string body;
+      while (decoder_.next(type, body)) {
+        process(type, body);
+        if (state_ == State::Closed)
+          break;
+      }
+      if (state_ == State::Closed) {
+        data.drain(data.length());
+        break;
+      }
+    }
+    if (end_stream && state_ != State::Closed)
+      fail(Failure(Status::NetworkError, "PostgreSQL stream ended"));
+  } catch (const Failure& error) {
+    fail(error);
+  } catch (const Json::exception&) {
+    fail(Failure(Status::ProtocolError, "invalid UTF8 PostgreSQL response"));
+  }
+  return Network::FilterStatus::StopIteration;
+}
+void Session::execute() {
+  if (!request_ || request_->done_) {
+    close();
+    return;
+  }
+  decoder_.setLimit(std::max<uint32_t>(config_.max_response_bytes, 16384));
+  state_ = State::Querying;
+  result_ = Result(config_);
+  query_error_.reset();
+  send(queryMessages(request_->query_));
+}
+void Session::assign(const std::shared_ptr<Pending>& request) {
+  if (idle_timer_)
+    idle_timer_->disableTimer();
+  request_ = request;
+  request->session_ = shared_from_this();
+  try {
+    execute();
+  } catch (const Failure& error) {
+    fail(error);
+  }
+}
+void Session::idle() {
+  decoder_.setLimit(16384);
+  state_ = State::Ready;
+  if (!idle_timer_)
+    idle_timer_ = dispatcher_.createTimer([weak = weak_from_this()] {
+      if (auto self = weak.lock())
+        self->close();
+    });
+  idle_timer_->enableTimer(std::chrono::milliseconds(config_.idle_timeout_ms));
+  if (auto client = client_.lock())
+    client->schedule();
+}
+void Session::process(char type, const std::string& body) {
+  if (type == 'N')
+    return;
+  if (type == 'S') {
+    Reader r(body);
+    auto key = r.string();
+    auto value = r.string();
+    r.end();
+    if (key == "client_encoding" && value != "UTF8")
+      throw Failure(Status::ProtocolError, "PostgreSQL changed client encoding");
+    return;
+  }
+  if (state_ == State::Authenticating) {
+    if (config_.tls_mode == "require") {
+      auto ssl = connection_->ssl();
+      if (!ssl || !ssl->peerCertificateValidated())
+        throw Failure(Status::AuthenticationError,
+                      "PostgreSQL TLS peer certificate was not validated");
+    }
+    if (type == 'E')
+      throw databaseError(body, true);
+    if (type == 'R') {
+      Reader r(body);
+      auto method = r.u32();
+      switch (method) {
+      case 0:
+        r.end();
+        if (scram_used_ && !scram_.verified())
+          throw Failure(Status::AuthenticationError, "unverified SCRAM exchange");
+        authenticated_ = true;
+        return;
+      case 3:
+        r.end();
+        if (!connection_->ssl() || !connection_->ssl()->peerCertificateValidated())
+          throw Failure(Status::AuthenticationError,
+                        "cleartext password authentication requires validated TLS");
+        send(passwordMessage(config_.password));
+        return;
+      case 5: {
+        auto salt = r.bytes(4);
+        r.end();
+        send(passwordMessage(md5Password(config_, salt)));
+        return;
+      }
+      case 10:
+        scram_used_ = true;
+        send(scram_.start(r.bytes(r.remaining())));
+        return;
+      case 11:
+        send(scram_.continueWith(r.bytes(r.remaining()), config_.password));
+        return;
+      case 12:
+        scram_.finish(r.bytes(r.remaining()));
+        return;
+      default:
+        throw Failure(Status::AuthenticationError, "unsupported PostgreSQL authentication method");
+      }
+    }
+    if (type == 'K') {
+      Reader r(body);
+      r.u32();
+      r.u32();
+      r.end();
+      return;
+    }
+    if (type == 'Z' && authenticated_ && body == "I") {
+      connect_timer_->disableTimer();
+      execute();
+      return;
+    }
+    throw Failure(Status::ProtocolError, "unexpected PostgreSQL startup message");
+  }
+  if (state_ == State::Querying) {
+    if (type == 'E') {
+      query_error_ = databaseError(body, false);
+      return;
+    }
+    if (type == 'Z') {
+      if (body != "I")
+        throw Failure(Status::ProtocolError,
+                      "PostgreSQL session is not idle; transaction API is unsupported");
+      if (!query_error_)
+        response_ = result_.encode();
+      state_ = State::Resetting;
+      reset_complete_ = false;
+      send(discardAll());
+      return;
+    }
+    if (query_error_)
+      throw Failure(Status::ProtocolError, "unexpected message after PostgreSQL error");
+    if (type == '1' || type == '2' || type == 'n') {
+      Reader(body).end();
+      return;
+    }
+    if (type == 'T') {
+      result_.columns(body);
+      return;
+    }
+    if (type == 'D') {
+      result_.row(body);
+      return;
+    }
+    if (type == 'C') {
+      result_.command(body);
+      return;
+    }
+    throw Failure(Status::ProtocolError,
+                  "unsupported PostgreSQL query response (COPY/cursors are not supported)");
+  }
+  if (state_ == State::Resetting) {
+    if (type == 'E')
+      throw Failure(Status::ProtocolError, "PostgreSQL session reset failed");
+    if (type == 'C') {
+      if (reset_complete_ || body != std::string("DISCARD ALL\0", 12))
+        throw Failure(Status::ProtocolError, "unexpected PostgreSQL reset response");
+      reset_complete_ = true;
+      return;
+    }
+    if (type == 'Z' && body == "I" && reset_complete_) {
+      auto error = std::move(query_error_);
+      auto response = std::move(response_);
+      result_ = Result(config_);
+      query_error_.reset();
+      response_.clear();
+      idle();
+      auto request = std::move(request_);
+      if (error)
+        request->finish(error->status, errorEnvelope(*error));
+      else
+        request->finish(Status::Ok, std::move(response));
+      return;
+    }
+    throw Failure(Status::ProtocolError, "unexpected PostgreSQL reset message");
+  }
+  throw Failure(Status::ProtocolError, "unsolicited PostgreSQL message");
+}
+} // namespace
+AsyncClientPtr createClient(std::string cluster, Config config, Upstream::ClusterManager& manager,
+                            Event::Dispatcher& dispatcher) {
+  if (budget.clients >= MaxClients)
+    throw Failure(Status::ResourceExhausted, "PostgreSQL client limit exceeded");
+  return std::make_shared<Client>(std::move(cluster), std::move(config), manager, dispatcher);
+}
+} // namespace Postgres
+} // namespace Envoy

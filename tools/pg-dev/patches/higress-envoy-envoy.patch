diff --git a/test/common/postgres/async_client_test.cc b/test/common/postgres/async_client_test.cc
new file mode 100644
index 0000000..efc7e61
--- /dev/null
+++ b/test/common/postgres/async_client_test.cc
@@ -0,0 +1,107 @@
+#include "source/common/postgres/async_client.h"
+
+#include <deque>
+
+#include "test/mocks/event/mocks.h"
+#include "test/mocks/upstream/cluster_manager.h"
+#include "gmock/gmock.h"
+#include "gtest/gtest.h"
+
+namespace Envoy {
+namespace Postgres {
+namespace {
+using testing::_;
+using testing::Invoke;
+using testing::NiceMock;
+using testing::Return;
+
+class PgAsyncClientTest : public testing::Test {
+public:
+  void SetUp() override {
+    ON_CALL(manager_, getThreadLocalCluster(_))
+        .WillByDefault(Return(&manager_.thread_local_cluster_));
+    ON_CALL(dispatcher_, post(_)).WillByDefault(Invoke([this](Event::PostCb callback) {
+      posts_.push_back(std::move(callback));
+    }));
+    ON_CALL(dispatcher_, createTimer_(_)).WillByDefault(Invoke([this](Event::TimerCb callback) {
+      timers_.push_back(std::move(callback));
+      return new NiceMock<Event::MockTimer>;
+    }));
+    Config config{"app", "secret", "app", "disable", 1000, 8, 128, 1000, 1048576, 65536, 60000};
+    client_ = createClient("pg", config, manager_, dispatcher_);
+  }
+  void TearDown() override {
+    client_->shutdown();
+    posts_.clear();
+    client_.reset();
+  }
+  void one() {
+    ASSERT_FALSE(posts_.empty());
+    auto callback = std::move(posts_.front());
+    posts_.pop_front();
+    callback();
+  }
+  void drain() {
+    while (!posts_.empty())
+      one();
+  }
+  RequestPtr submit(AsyncClient::Callback callback) {
+    return client_->send(R"({"version":1,"sql":"SELECT 1","params":[]})",
+                         std::chrono::milliseconds(500), std::move(callback));
+  }
+  NiceMock<Event::MockDispatcher> dispatcher_;
+  NiceMock<Upstream::MockClusterManager> manager_;
+  AsyncClientPtr client_;
+  std::deque<Event::PostCb> posts_;
+  std::vector<Event::TimerCb> timers_;
+};
+
+TEST_F(PgAsyncClientTest, CompletionIsPostedAndDeliveredOnce) {
+  size_t calls = 0;
+  auto request = submit([&](Status status, std::string body) {
+    ++calls;
+    EXPECT_EQ(status, Status::NetworkError);
+    EXPECT_EQ(Json::parse(body)["version"], 1);
+  });
+  ASSERT_NE(request, nullptr);
+  EXPECT_EQ(calls, 0U);
+  // The mock cluster supplies no endpoint, an immediate native failure must still be deferred.
+  drain();
+  EXPECT_EQ(calls, 1U);
+  timers_.front()();
+  drain();
+  EXPECT_EQ(calls, 1U);
+}
+TEST_F(PgAsyncClientTest, CancellationBeforeDispatchReleasesCallback) {
+  size_t calls = 0;
+  auto request = submit([&](Status, std::string) { ++calls; });
+  ASSERT_NE(request, nullptr);
+  request->cancel();
+  timers_.front()();
+  drain();
+  EXPECT_EQ(calls, 0U);
+}
+TEST_F(PgAsyncClientTest, QueueDeadlineIsTerminal) {
+  size_t calls = 0;
+  auto request = submit([&](Status status, std::string) {
+    ++calls;
+    EXPECT_EQ(status, Status::Timeout);
+  });
+  ASSERT_NE(request, nullptr);
+  timers_.front()();
+  timers_.front()();
+  drain();
+  EXPECT_EQ(calls, 1U);
+}
+TEST_F(PgAsyncClientTest, ShutdownSuppressesAlreadyPostedCompletion) {
+  size_t calls = 0;
+  auto request = submit([&](Status, std::string) { ++calls; });
+  ASSERT_NE(request, nullptr);
+  one(); // connection failure has queued completion, but has not entered the caller
+  client_->shutdown();
+  drain();
+  EXPECT_EQ(calls, 0U);
+}
+} // namespace
+} // namespace Postgres
+} // namespace Envoy
diff --git a/test/common/postgres/codec_test.cc b/test/common/postgres/codec_test.cc
new file mode 100644
index 0000000..698ad69
--- /dev/null
+++ b/test/common/postgres/codec_test.cc
@@ -0,0 +1,136 @@
+#include "source/common/postgres/codec.h"
+#include "gtest/gtest.h"
+
+namespace Envoy {
+namespace Postgres {
+namespace {
+Config config() {
+  return Config{"app", "secret", "app", "disable", 1000, 8, 128, 2, 4096, 65536, 60000};
+}
+TEST(PgCodec, SplitAndCoalescedFrames) {
+  auto bytes = message('C', std::string("SELECT 1\0", 9)) + message('Z', "I");
+  Decoder decoder(4096);
+  char type;
+  std::string body;
+  for (size_t i = 0; i < bytes.size(); ++i) {
+    decoder.append(std::string_view(bytes).substr(i, 1));
+    if (i == 13) {
+      ASSERT_TRUE(decoder.next(type, body));
+      EXPECT_EQ(type, 'C');
+    } else if (i == bytes.size() - 1) {
+      ASSERT_TRUE(decoder.next(type, body));
+      EXPECT_EQ(type, 'Z');
+      EXPECT_EQ(body, "I");
+    } else
+      EXPECT_FALSE(decoder.next(type, body));
+  }
+}
+TEST(PgCodec, InvalidLengthAndOversize) {
+  Decoder decoder(256);
+  char type;
+  std::string body;
+  decoder.append(std::string("D\0\0\0\3", 5));
+  EXPECT_THROW(decoder.next(type, body), Failure);
+  EXPECT_THROW(decoder.append(std::string(257, 'a')), Failure);
+}
+TEST(PgCodec, DecoderLimitTransitionPreservesPartialFrames) {
+  Decoder decoder(4096);
+  decoder.append(message('Z', "I") + std::string("C", 1));
+  char type;
+  std::string body;
+  ASSERT_TRUE(decoder.next(type, body));
+  decoder.setLimit(256);
+  EXPECT_FALSE(decoder.next(type, body));
+  auto command = message('C', std::string("SELECT 1\0", 9));
+  decoder.append(std::string_view(command).substr(1));
+  ASSERT_TRUE(decoder.next(type, body));
+  EXPECT_EQ(type, 'C');
+  EXPECT_EQ(body, std::string("SELECT 1\0", 9));
+  decoder.setLimit(16);
+  EXPECT_EQ(decoder.buffered(), 0U);
+}
+
+TEST(PgCodec, RejectsDeeplyNestedUnknownEnvelopeFields) {
+  const auto nested = std::string(64, '[') + "0" + std::string(64, ']');
+  const auto query = R"({"version":1,"sql":"SELECT 1","params":[],"ignored":)" + nested + "}";
+  EXPECT_THROW(Query::parse(query, 4096), Failure);
+  EXPECT_THROW(Config::parse(query), Failure);
+}
+
+TEST(PgCodec, ParameterBindingIsSeparateFromSql) {
+  Query query = Query::parse(
+      R"({"version":1,"sql":"SELECT $1, $2","params":[{"type_oid":25,"value":"'; SELECT 2"},{"type_oid":25,"value":null}]})",
+      1024);
+  Decoder decoder(4096);
+  decoder.append(queryMessages(query));
+  char type;
+  std::string body;
+  ASSERT_TRUE(decoder.next(type, body));
+  EXPECT_EQ(type, 'P');
+  Reader parse(body);
+  EXPECT_EQ(parse.string(), "");
+  EXPECT_EQ(parse.string(), "SELECT $1, $2");
+  EXPECT_EQ(parse.u16(), 2);
+  EXPECT_EQ(parse.u32(), 25U);
+  EXPECT_EQ(parse.u32(), 25U);
+  parse.end();
+  ASSERT_TRUE(decoder.next(type, body));
+  EXPECT_EQ(type, 'B');
+  Reader bind(body);
+  bind.string();
+  bind.string();
+  EXPECT_EQ(bind.u16(), 0);
+  EXPECT_EQ(bind.u16(), 2);
+  EXPECT_EQ(bind.bytes(bind.u32()), "'; SELECT 2");
+  EXPECT_EQ(bind.u32(), UINT32_MAX);
+  EXPECT_EQ(bind.u16(), 0);
+  bind.end();
+}
+TEST(PgCodec, ResultPreservesDuplicateColumnsNullAndPrecision) {
+  auto c = config();
+  Result result(c);
+  std::string description;
+  put16(description, 2);
+  for (int i = 0; i < 2; ++i) {
+    description += std::string("v\0", 2);
+    put32(description, 0);
+    put16(description, 0);
+    put32(description, 20);
+    put16(description, 8);
+    put32(description, UINT32_MAX);
+    put16(description, 0);
+  }
+  result.columns(description);
+  std::string row;
+  put16(row, 2);
+  std::string value = "9223372036854775807";
+  put32(row, value.size());
+  row += value;
+  put32(row, UINT32_MAX);
+  result.row(row);
+  result.command(std::string("SELECT 1\0", 9));
+  const auto json = Json::parse(result.encode());
+  EXPECT_EQ(json["rows"][0][0], value);
+  EXPECT_TRUE(json["rows"][0][1].is_null());
+  EXPECT_EQ(json["columns"][0]["name"], json["columns"][1]["name"]);
+  EXPECT_THROW(result.row(row), Failure);
+}
+TEST(PgCodec, ScramRejectsWrongNonceAndServerSignature) {
+  Scram scram;
+  auto initial = scram.start(std::string("SCRAM-SHA-256\0\0", 15));
+  EXPECT_THROW(scram.continueWith("r=wrong,s=YWJjZA==,i=4096", "secret"), Failure);
+  auto nonce = initial.substr(initial.find("n,,n=,r=") + 8);
+  auto next = scram.continueWith("r=" + nonce + "server,s=YWJjZA==,i=4096", "secret");
+  EXPECT_FALSE(next.empty());
+  EXPECT_THROW(scram.finish("v=YWJjZA=="), Failure);
+}
+TEST(PgCodec, DatabaseErrorsNeverEchoServerDiagnostics) {
+  auto failure = databaseError(std::string("C42601\0", 7) +
+                                   std::string("Msecret password SQL\0", 21) + std::string(1, '\0'),
+                               false);
+  EXPECT_EQ(failure.sqlstate, "42601");
+  EXPECT_EQ(errorEnvelope(failure).find("secret"), std::string::npos);
+}

+bool Context::onConfigure(std::shared_ptr<proxy_wasm::PluginBase> plugin) {
+  // Existing in-flight operations hold their client; new handles belong to this generation.
+  pg_clients_.clear();
+  pg_client_configs_.clear();
+  return ContextBase::onConfigure(std::move(plugin));
+}
+
+WasmResult Context::pgInit(std::string_view cluster, std::string_view config, uint32_t* client) {
+  if (cluster.empty() || cluster.size() > 4096 || config.size() > 16384 ||
+      cluster.find('\0') != std::string_view::npos ||
+      !clusterManager().getThreadLocalCluster(std::string(cluster))) {
+    return WasmResult::BadArgument;
+  }
+  std::string key(cluster);
+  key.push_back('\0');
+  key.append(config);
+  auto existing = pg_client_configs_.find(key);
+  if (existing != pg_client_configs_.end()) {
+    *client = existing->second;
+    return WasmResult::Ok;
+  }
+  if (pg_clients_.size() >= 64 || next_pg_client_id_ == UINT32_MAX) {
+    return WasmResult::InternalFailure;
+  }
+  try {
+    auto parsed = Postgres::Config::parse(config);
+    auto native = Postgres::createClient(std::string(cluster), std::move(parsed), clusterManager(),
+                                         wasm()->dispatcher());
+    *client = ++next_pg_client_id_;
+    pg_clients_.emplace(*client, std::move(native));
+    pg_client_configs_.emplace(std::move(key), *client);
+    return WasmResult::Ok;
+  } catch (const Postgres::Failure&) {
+    return WasmResult::BadArgument;
+  }
+}
+
+WasmResult Context::pgCall(uint32_t client, std::string_view request, uint32_t timeout,
+                           uint32_t* token) {
+  auto* root = rootContext();
+  auto found = root->pg_clients_.find(client);
+  if (destroyed_ || !wasm()->hasPgCallResponse() || found == root->pg_clients_.end() ||
+      timeout == 0 || timeout > INT32_MAX) {
+    return WasmResult::BadArgument;
+  }
+  uint32_t id = 0;
+  try {
+    id = wasm()->nextPgCallId();
+    if (!id)
+      return WasmResult::InternalFailure;
+    auto native = found->second;
+    auto pending = native->send(request, std::chrono::milliseconds(timeout),
+                                [this, id](Postgres::Status status, std::string response) {
+                                  onPgComplete(id, status, std::move(response));
+                                });
+    if (!pending) {
+      wasm()->releasePgCallId(id);
+      return WasmResult::InternalFailure;
+    }
+    pg_requests_.emplace(id, PgPending{std::move(native), std::move(pending)});
+    *token = id;
+    return WasmResult::Ok;
+  } catch (const Postgres::Failure&) {
+    if (id)
+      wasm()->releasePgCallId(id);
+    return WasmResult::BadArgument;
+  }
+}
+
+void Context::cancelPgRequests() {
+  for (auto& entry : pg_requests_) {
+    entry.second.request->cancel();
+    if (wasm() != nullptr)
+      wasm()->releasePgCallId(entry.first);
+  }
+  pg_requests_.clear();
+}
+
+void Context::onPgComplete(uint32_t token, Postgres::Status status, std::string response) {
+  auto found = pg_requests_.find(token);
+  if (found == pg_requests_.end())
+    return;
+  if (destroyed_ || isFailed()) {
+    found->second.request->cancel();
+    pg_requests_.erase(found);
+    if (wasm() != nullptr)
+      wasm()->releasePgCallId(token);
+    return;
+  }
+  // Pending posts completion, so token registration and the original Wasm invocation have finished.
+  auto pending = std::move(found->second);
+  pg_requests_.erase(found);
+  wasm()->releasePgCallId(token);
+  pg_call_response_ = std::move(response);
+  pg_in_callback_ = true;
+  const uint32_t size = pg_call_response_.size();
+  // ContextBase may delete this Context as an after-call action. No access to this after call.
+  wasm()->addAfterVmCallAction([this] {
+    pg_in_callback_ = false;
+    pg_call_response_.clear();
+  });
+  ContextBase::onPgCallResponse(token, static_cast<uint32_t>(status), size);
+}

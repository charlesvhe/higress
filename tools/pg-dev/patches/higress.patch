diff --git a/plugins/wasm-rust/example/pg-query/README.md b/plugins/wasm-rust/example/pg-query/README.md
new file mode 100644
index 00000000..44094a16
--- /dev/null
+++ b/plugins/wasm-rust/example/pg-query/README.md
@@ -0,0 +1,31 @@
+# PG 查询验证插件
+
+用于验证本地定制网关的 PostgreSQL ABI。原版 Higress 2.2.6 无此接口。
+
+SDK 与所有 Rust 插件的 `proxy-wasm` 依赖已指向工作区同级的
+`proxy-wasm-rust-sdk/`，避免同时加载两份不同来源的 Context trait。
+
+在工作区根目录执行 `./pg-dev/build-rust.sh`，产物位于
+`example/pg-query/target/wasm32-wasip1/release/pg_query.wasm`。
+脚本处理新 Rust WASI reactor CRT 与 SDK `_initialize` 的重复定义；不修改既有插件入口宏。
+
+插件配置示例（JSON）：
+
+```json
+{"cluster":"pg","username":"app","password":"test-password","database":"postgres","tls_mode":"disable","timeout_ms":500,"max_rows":1000}
+```
+
+这里的明文配置仅供隔离测试。`tls_mode` 默认 `require`，需要配置 PG cluster 的
+`envoy.transport_sockets.starttls` transport socket，并在 TLS context 中配置 CA 和 SAN 校验。
+`disable` 必须显式选择。
+
+HTTP 请求体是查询信封，例如：
+
+```json
+{"sql":"SELECT $1::int8, $2::text","params":[{"type_oid":20,"value":"123"},{"type_oid":25,"value":null}]}
+```
+
+插件通过本地响应返回列、行和命令标签；不将该接口作为公开 SQL 服务部署。
+调用成功后暂停 HTTP 流，PG 回调返回本地响应；请求结束后的回调由 SDK/宿主取消。
+
+协议、连接池及构建背景见工作区根目录的技术方案和 `pg-dev/README.md`。
diff --git a/plugins/wasm-rust/example/pg-query/src/lib.rs b/plugins/wasm-rust/example/pg-query/src/lib.rs
new file mode 100644
index 00000000..4751f621
--- /dev/null
+++ b/plugins/wasm-rust/example/pg-query/src/lib.rs
@@ -0,0 +1,162 @@
+//! Local verification plugin. The HTTP body is a query envelope, not a production API.
+use higress_wasm_rust::{cluster_wrapper::Cluster, pg_wrapper::*};
+use proxy_wasm::{hostcalls, traits::*, types::*};
+use serde::Deserialize;
+use std::time::Duration;
+
+struct TestCluster(String);
+impl Cluster for TestCluster {
+    fn cluster_name(&self) -> String {
+        self.0.clone()
+    }
+    fn host_name(&self) -> String {
+        self.0.clone()
+    }
+}
+
+#[derive(Deserialize)]
+struct Config {
+    cluster: String,
+    username: String,
+    password: String,
+    database: String,
+    #[serde(default = "timeout")]
+    timeout_ms: u64,
+    #[serde(default = "tls")]
+    tls_mode: String,
+    #[serde(default = "rows")]
+    max_rows: u32,
+}
+fn timeout() -> u64 {
+    500
+}
+fn tls() -> String {
+    "require".into()
+}
+fn rows() -> u32 {
+    1000
+}
+#[derive(Default)]
+struct Root {
+    client: Option<PgClient>,
+}
+impl Context for Root {}
+impl RootContext for Root {
+    fn on_configure(&mut self, _: usize) -> bool {
+        self.client = None;
+        let result = (|| -> Result<PgClient, Box<dyn std::error::Error>> {
+            let data = self
+                .get_plugin_configuration()
+                .ok_or("missing configuration")?;
+            let config: Config = serde_json::from_slice(&data)?;
+            let cluster = TestCluster(config.cluster);
+            let client = PgClientBuilder::new(&cluster, Duration::from_millis(config.timeout_ms))
+                .username(config.username)
+                .password(config.password)
+                .database(config.database)
+                .tls_mode(config.tls_mode)
+                .max_rows(config.max_rows)
+                .build()?;
+            client.init()?;
+            Ok(client)
+        })();
+        match result {
+            Ok(client) => {
+                self.client = Some(client);
+                true
+            }
+            Err(_) => {
+                let _ = hostcalls::log(
+                    LogLevel::Error,
+                    "PG verification client configuration failed",
+                );
+                false
+            }
+        }
+    }
+    fn get_type(&self) -> Option<ContextType> {
+        Some(ContextType::HttpContext)
+    }
+    fn create_http_context(&self, _: u32) -> Option<Box<dyn HttpContext>> {
+        Some(Box::new(QueryContext {
+            client: self.client.clone(),
+            submitted: false,
+        }))
+    }
+}
+struct QueryContext {
+    client: Option<PgClient>,
+    submitted: bool,
+}
+impl Context for QueryContext {}
+fn reply(status: u32, body: &[u8]) {
+    let _ = hostcalls::send_http_response(
+        status,
+        vec![("content-type", "application/json")],
+        Some(body),
+    );
+}
+impl QueryContext {
+    fn submit(&mut self, body: &[u8]) {
+        if self.submitted {
+            return;
+        }
+        self.submitted = true;
+        #[derive(Deserialize)]
+        struct Request {
+            sql: String,
+            #[serde(default)]
+            params: Vec<PgParam>,
+        }
+        let request: Request = match serde_json::from_slice(body) {
+            Ok(request) => request,
+            Err(_) => {
+                reply(400, br#"{"error":"invalid query envelope"}"#);
+                return;
+            }
+        };
+        let Some(client) = &self.client else {
+            reply(503, br#"{"error":"PG unavailable"}"#);
+            return;
+        };
+        let result = client.query(&request.sql, &request.params, Box::new(|result| match result {
+            Ok(result) => {
+                let data = serde_json::json!({"columns": result.columns, "rows": result.rows, "command_tag": result.command_tag});
+                reply(200, data.to_string().as_bytes());
+            }
+            Err(error) => {
+                let status = match error.kind {
+                    PgErrorKind::Timeout => 504,
+                    PgErrorKind::Database => 400,
+                    PgErrorKind::ResourceExhausted => 429,
+                    _ => 502,
+                };
+                reply(status, serde_json::json!({"error": error.message, "sqlstate": error.sqlstate}).to_string().as_bytes());
+            }
+        }));
+        if result.is_err() {
+            reply(503, br#"{"error":"PG submission failed"}"#);
+        }
+    }
+}
+impl HttpContext for QueryContext {
+    fn on_http_request_headers(&mut self, _: usize, end: bool) -> HeaderAction {
+        if end {
+            self.submit(br#"{"sql":"SELECT 1"}"#);
+        }
+        HeaderAction::StopIteration
+    }
+    fn on_http_request_body(&mut self, size: usize, end: bool) -> DataAction {
+        if size > 65536 {
+            reply(413, br#"{"error":"query body too large"}"#);
+            return DataAction::StopIterationNoBuffer;
+        }
+        if !end {
+            return DataAction::StopIterationAndBuffer;
+        }
+        let body = self.get_http_request_body(0, size).unwrap_or_default();
+        self.submit(&body);
+        DataAction::StopIterationNoBuffer
+    }
+}
+proxy_wasm::main! {{ proxy_wasm::set_root_context(|_| Box::<Root>::default()); }}
